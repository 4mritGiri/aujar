#!/bin/sh
set -e

case "$1" in
    remove|upgrade|deconfigure)
        # Disable user services
        if [ -n "$SUDO_USER" ] && command -v systemctl >/dev/null 2>&1; then
            su - "$SUDO_USER" -c 'systemctl --user disable aujar.service aujar-ui.service' 2>/dev/null || true
        fi
        
        # Disable system service
        if [ -f /usr/lib/systemd/system/aujar-mouse-borders.service ]; then
            systemctl disable aujar-mouse-borders.service 2>/dev/null || true
        fi
        ;;
    *)
        ;;
esac

.exit 0
