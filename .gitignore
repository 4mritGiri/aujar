
# ==========================================
# Rust / Cargo
# ==========================================

# Build output (all Rust projects, including nested workspaces)
target/
**/target/

# Rust backup files
**/*.rs.bk

# Cargo generated files
Cargo.lock.old

# ==========================================
# Build and release artifacts
# ==========================================

/dist/
build/
out/

*.deb
*.rpm
*.dmg
*.AppImage
*.exe
*.msi
*.zip
*.tar
*.tar.gz
*.7z

# ==========================================
# Environment and secrets
# ==========================================

.env
.env.*
!.env.example
!.env.sample

.direnv/
*.pem
*.key
*.p12
*.pfx

# ==========================================
# OS-generated files
# ==========================================

.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini

# ==========================================
# Editors and IDEs
# ==========================================

.idea/
.vscode/
*.swp
*.swo
*~
*.tmp

# Keep shared Zed configuration committed
# .zed/

# ==========================================
# Logs and temporary files
# ==========================================

*.log
logs/
tmp/
temp/

# ==========================================
# Node.js (if used by frontend tooling)
# ==========================================

node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==========================================
# Test and coverage output
# ==========================================

coverage/
lcov.info/
*.profraw
*.profdata

# ==========================================
# Generated documentation
# ==========================================

/target/doc/
/docs-build/

# ==========================================
# Local databases and runtime files
# ==========================================

*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

# ==========================================
