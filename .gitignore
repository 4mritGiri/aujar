# Build output. No leading slash on purpose: aujar-ui and NexDesk keep their own target/
# directories (apps/aujar-ui/target, integrations/nexdesk/target), and a slash-anchored
# pattern would only match the one at the repository root.
target/
**/target/
**/*.rs.bk

# Packages and release artifacts (scripts/build-nexdesk.sh --deb writes to ./dist)
/dist/
*.deb
*.rpm
/*.zip

# Local environment
.env
.direnv/
.DS_Store

# Editors: .zed/ is committed (shared tasks, settings, debug configs); personal files are not.
.idea/
*.swp
*~
