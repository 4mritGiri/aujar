[Unit]
Description=Aujar Desktop Productivity Platform
Documentation=https://github.com/4mritGiri/aujar
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Packaged path. Source installs use scripts/install-local.sh, which rewrites this line.
ExecStart=/usr/bin/aujar daemon
Restart=on-failure
RestartSec=2
Environment=RUST_LOG=info
# Light hardening that works in unprivileged user units (mount-namespace options such as
# ProtectSystem= need user namespaces, which some distros restrict).
NoNewPrivileges=true
LockPersonality=true

[Install]
WantedBy=graphical-session.target
