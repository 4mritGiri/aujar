[Unit]
Description=Aujar Desktop Productivity Platform
Documentation=https://github.com/4mritGiri/aujar
PartOf=graphical-session.target
After=graphical-session.target
# A crash loop must end instead of flickering the desktop forever.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
# Packaged path. Source installs use scripts/install-local.sh, which rewrites this line.
ExecStart=/usr/bin/aujar daemon
Restart=on-failure
RestartSec=2
# 75: another daemon is already running. That is not a failure to retry.
SuccessExitStatus=75
RestartPreventExitStatus=75
Environment=RUST_LOG=info
# No sandboxing directives here, on purpose. Every application the launcher starts is a child of
# this service and inherits them: NoNewPrivileges= makes setuid programs fail (VirtualBox:
# "Effective UID is not root", ping, Wireshark's capture helper, ...), LockPersonality= breaks
# some 32-bit and Wine programs, and ProtectSystem=/ProtectHome=/PrivateTmp= would change what
# launched applications can see. A test (crates/aujar-daemon/tests/unit_files.rs) keeps it so.

[Install]
WantedBy=graphical-session.target
