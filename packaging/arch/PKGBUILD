# Maintainer: Aujar Contributors <https://github.com/4mritGiri/aujar>
pkgname=aujar
pkgver=0.1.1
pkgrel=1
pkgdesc="Modular productivity toolkit for Linux desktops (CLI and daemon)"
arch=('x86_64' 'aarch64')
url="https://github.com/4mritGiri/aujar"
license=('Apache-2.0')
depends=('gcc-libs' 'glibc')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP') # replace with the real checksum before publishing to the AUR

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p aujar-launcher-app
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen -p aujar-launcher-app -p aujar-core -p aujar-ipc -p aujar-rename -p aujar-launcher
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/aujar "$pkgdir/usr/bin/aujar"
  install -Dm644 packaging/systemd/aujar.service "$pkgdir/usr/lib/systemd/user/aujar.service"
  install -Dm644 packaging/desktop/dev.aujar.Aujar.desktop \
    "$pkgdir/usr/share/applications/dev.aujar.Aujar.desktop"
  install -Dm644 config/policy.example.toml "$pkgdir/usr/share/doc/$pkgname/policy.example.toml"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
