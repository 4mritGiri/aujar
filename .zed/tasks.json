// Zed tasks for Aujar. Run one with the command palette: `task: spawn`
// (re-run the last one with `task: rerun`). They mirror the justfile; the long-running ones
// (daemon, UI, events) keep their terminal open.
[
  // ---- quality gates -------------------------------------------------------------------
  {
    "label": "check: fmt + clippy + tests (same as CI)",
    "command": "just",
    "args": ["check"],
    "reveal": "always",
    "allow_concurrent_runs": false
  },
  {
    "label": "check: tests only",
    "command": "just",
    "args": ["test"],
    "reveal": "always"
  },
  {
    "label": "check: clippy only",
    "command": "just",
    "args": ["lint"],
    "reveal": "always"
  },
  {
    "label": "check: format everything",
    "command": "just",
    "args": ["fmt"],
    "reveal": "always"
  },
  {
    "label": "check: cargo test for the crate of the current file",
    // cargo finds the nearest Cargo.toml above this directory.
    "command": "cargo",
    "args": ["test"],
    "cwd": "$ZED_DIRNAME",
    "reveal": "always"
  },
  {
    "label": "ui: check (clippy on aujar-ui, needs GPU/windowing headers)",
    "command": "just",
    "args": ["check-ui"],
    "reveal": "always"
  },

  // ---- run -----------------------------------------------------------------------------
  {
    "label": "run: daemon (foreground, debug logging)",
    "command": "cargo",
    "args": ["run", "-p", "aujar-launcher-app", "--", "daemon"],
    "env": { "RUST_LOG": "debug" },
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "run: UI (release, as the project's docs do)",
    "command": "cargo",
    "args": ["run", "-p", "aujar-ui", "--release"],
    "env": { "RUST_LOG": "info" },
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "run: UI (debug build; faster to compile, slower to run)",
    "command": "cargo",
    "args": ["run", "-p", "aujar-ui"],
    "env": { "RUST_LOG": "info" },
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "run: Mouse Borders agent (aujar-mwb) in the foreground",
    "command": "cargo",
    "args": ["run", "-p", "aujar-mwb", "--", "run"],
    "env": { "RUST_LOG": "debug" },
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },

  // ---- the daily loop: rebuild and restart on every save --------------------------------
  // `just dev` runs the daemon and the UI on a private socket (/tmp/aujar-dev.sock) under
  // cargo-watch, without the global shortcut, so the installed Aujar is left alone. Stop with
  // Ctrl+C in its terminal. Install cargo-watch with ./scripts/setup-dev.sh.
  {
    "label": "dev: everything, rebuilt on save (daemon + UI)",
    "command": "just",
    "args": ["dev"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "dev: daemon only, rebuilt on save (CLI / launcher engine / Mouse Borders)",
    "command": "just",
    "args": ["dev-daemon"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "dev: everything with its own settings and state (does not touch ~/.config/aujar)",
    "command": "just",
    "args": ["dev-isolated"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "dev: everything with IPC trace (every daemon request, kind + timing)",
    "command": "./scripts/dev.sh",
    "args": ["--ipc-trace"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "dev: everything, offline (define / weather / stock answered from dev/fixtures)",
    "command": "just",
    "args": ["dev-offline"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "fixtures: record real answers of the online lookups (needs the network)",
    "command": "just",
    "args": ["record-fixtures"],
    "reveal": "always"
  },
  {
    "label": "check: watch (cargo check on every save)",
    "command": "just",
    "args": ["watch"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "check: everything CI runs (just ci)",
    "command": "just",
    "args": ["ci"],
    "reveal": "always",
    "allow_concurrent_runs": false
  },

  // ---- Mouse Borders lab: two daemons on this machine, paired over loopback ------------
  // For pairing, the key, connections, file transfer, status, protocol changes. Not for moving
  // the pointer between machines (that needs two real computers). Details: docs/DEVELOPMENT.md.
  {
    "label": "lab: Mouse Borders up (two paired daemons)",
    "command": "just",
    "args": ["lab-up"],
    "reveal": "always"
  },
  {
    "label": "lab: Mouse Borders status",
    "command": "just",
    "args": ["lab-status"],
    "reveal": "always"
  },
  {
    "label": "lab: Mouse Borders smoke test (pair, connect, send a file, shut down)",
    "command": "just",
    "args": ["lab-smoke"],
    "reveal": "always"
  },
  {
    "label": "lab: Mouse Borders down",
    "command": "just",
    "args": ["lab-down"],
    "reveal": "always"
  },

  // ---- isolated dev instance, by hand ---------------------------------------------------
  // The CLI and the UI honor AUJAR_SOCKET, so a dev daemon on its own socket runs beside your
  // installed Aujar without stopping it. Start the daemon first, then the UI and the others.
  // (Shared across both: ~/.config and ~/.local/state, and the desktop's global shortcut and
  // portals. To test the shortcut, stop the installed services instead; see "services" below.)
  {
    "label": "dev: daemon on its own socket (/tmp/aujar-dev.sock)",
    "command": "cargo",
    "args": ["run", "-p", "aujar-launcher-app", "--", "daemon"],
    "env": { "AUJAR_SOCKET": "/tmp/aujar-dev.sock", "RUST_LOG": "debug" },
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "dev: UI on the dev socket (debug build)",
    "command": "cargo",
    "args": ["run", "-p", "aujar-ui"],
    "env": { "AUJAR_SOCKET": "/tmp/aujar-dev.sock", "RUST_LOG": "info" },
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "dev: doctor --dev against the dev daemon",
    "command": "cargo",
    "args": ["run", "-q", "-p", "aujar-launcher-app", "--", "doctor", "--dev"],
    "env": { "AUJAR_SOCKET": "/tmp/aujar-dev.sock" },
    "reveal": "always"
  },
  {
    "label": "dev: events from the dev daemon",
    "command": "cargo",
    "args": ["run", "-q", "-p", "aujar-launcher-app", "--", "events"],
    "env": { "AUJAR_SOCKET": "/tmp/aujar-dev.sock" },
    "use_new_terminal": true,
    "reveal": "always"
  },
  {
    "label": "dev: doctor against the dev daemon",
    "command": "cargo",
    "args": ["run", "-q", "-p", "aujar-launcher-app", "--", "doctor"],
    "env": { "AUJAR_SOCKET": "/tmp/aujar-dev.sock" },
    "reveal": "always"
  },

  // ---- inspect the running daemon ------------------------------------------------------
  {
    "label": "aujar: doctor --dev (adds socket source, env vars, log and settings paths, services)",
    "command": "cargo",
    "args": ["run", "-q", "-p", "aujar-launcher-app", "--", "doctor", "--dev"],
    "reveal": "always"
  },
  {
    "label": "aujar: doctor (is the daemon up, which session, is the shortcut bound)",
    "command": "cargo",
    "args": ["run", "-q", "-p", "aujar-launcher-app", "--", "doctor"],
    "reveal": "always"
  },
  {
    "label": "aujar: events (watch daemon -> UI events)",
    "command": "cargo",
    "args": ["run", "-q", "-p", "aujar-launcher-app", "--", "events"],
    "use_new_terminal": true,
    "reveal": "always"
  },
  {
    "label": "aujar: platform (what works on this desktop)",
    "command": "cargo",
    "args": ["run", "-q", "-p", "aujar-launcher-app", "--", "platform"],
    "reveal": "always"
  },
  {
    "label": "aujar: mwb report (paste this in Mouse Borders bug reports)",
    "command": "cargo",
    "args": ["run", "-q", "-p", "aujar-launcher-app", "--", "mwb", "report"],
    "reveal": "always"
  },

  // ---- logs ----------------------------------------------------------------------------
  // The UI is normally started from the desktop and has no terminal. Run it with a log file
  // (AUJAR_LOG_FILE=1 writes <state dir>/logs/aujar-ui.log, 0600, rotated at 5 MiB), then
  // follow it here.
  {
    "label": "run: UI with a log file, debug messages (AUJAR_LOG_FILE=1)",
    "command": "cargo",
    "args": ["run", "-p", "aujar-ui"],
    "env": { "AUJAR_LOG_FILE": "1", "AUJAR_DEBUG": "1" },
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "logs: follow the Aujar log files (~/.local/state/aujar/logs)",
    "command": "tail -n 100 -F ~/.local/state/aujar/logs/*.log",
    "use_new_terminal": true,
    "reveal": "always"
  },

  // ---- installed (systemd) instance ----------------------------------------------------
  // The plain "run: daemon" task uses the default socket, which the installed service also
  // owns. Stop the installed services before using it (or use the "dev:" tasks above).
  {
    "label": "services: stop the installed Aujar (before run: daemon)",
    "command": "systemctl",
    "args": ["--user", "stop", "aujar.service", "aujar-ui.service"],
    "reveal": "always"
  },
  {
    "label": "services: start the installed Aujar",
    "command": "systemctl",
    "args": ["--user", "start", "aujar.service", "aujar-ui.service"],
    "reveal": "always"
  },
  {
    "label": "services: logs of the installed Aujar",
    "command": "journalctl",
    "args": ["--user", "-u", "aujar.service", "-u", "aujar-ui.service", "-n", "100", "--no-pager"],
    "reveal": "always"
  },

  // ---- environment ---------------------------------------------------------------------
  {
    "label": "setup: install development dependencies",
    "command": "./scripts/setup-dev.sh",
    "use_new_terminal": true,
    "reveal": "always"
  },
  {
    "label": "hooks: turn the git hooks on (Conventional Commits, DCO, fmt, clippy)",
    "command": "just",
    "args": ["hooks"],
    "reveal": "always"
  },
  {
    "label": "hooks: test them in a throw-away repository",
    "command": "just",
    "args": ["hooks-test"],
    "reveal": "always"
  },
  {
    "label": "setup: verify the environment (no changes)",
    "command": "./scripts/setup-dev.sh",
    "args": ["--check"],
    "reveal": "always"
  },
  {
    "label": "nexdesk: build (separate workspace)",
    "command": "./scripts/build-nexdesk.sh",
    "use_new_terminal": true,
    "reveal": "always"
  }
]
